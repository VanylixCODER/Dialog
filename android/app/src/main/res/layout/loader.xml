<?xml version="1.0" encoding="utf-8"?>
<!-- Clean branded splash: logo + wordmark + a slim indeterminate bar + status.
     (Replaced the terminal boot-log screen.) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loaderRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:src="@drawable/dialog_logo"
            android:contentDescription="Dialog" />

        <TextView
            android:id="@+id/logoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DIALOG"
            android:textColor="@color/green"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.32"
            android:layout_marginTop="22dp"
            android:shadowColor="@color/green"
            android:shadowRadius="22" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MESSENGER"
            android:textColor="@color/green_dim"
            android:textSize="10sp"
            android:letterSpacing="0.5"
            android:layout_marginTop="6dp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="150dp"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/green"
            android:layout_marginTop="40dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting…"
            android:textColor="@color/amber"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</FrameLayout>
