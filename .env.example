# Dialog — configuration. Copy to .env and fill in.
# Only the DB_* block is required; everything else degrades gracefully.

# ── Database (required) ───────────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_USER=dialog
DB_PASS=change-me
DB_NAME=dialog
# DB_SSL=true          # managed MySQL that requires TLS
# DB_POOL=10

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:3000
# ADMIN_LOGINS=admin   # comma-separated logins that get the admin panel
# UPLOAD_DIR=/data/uploads   # where attachments are written

# ── Cache (optional) ──────────────────────────────────────────────────────────
# REDIS_URL=redis://redis:6379

# ── Calls ─────────────────────────────────────────────────────────────────────
# Media is peer-to-peer; a TURN relay is only used when two peers cannot reach
# each other directly. Without it, calls still work on most networks.
# TURN_URL=turn:your.turn.host:3478
# TURN_USER=
# TURN_PASS=
# METERED_API_KEY=     # alternative: fetch TURN credentials from Metered

# ── Push notifications (optional) ─────────────────────────────────────────────
# VAPID_PUBLIC=
# VAPID_PRIVATE=
# VAPID_SUBJECT=mailto:you@example.com
# FCM_SA_PATH=./docs/firebase-service-account.json   # Android push

# ── Email (optional — verification + password reset) ──────────────────────────
# RESEND_API_KEY=
# MAIL_FROM=Dialog <no-reply@example.com>

# ── Extras ────────────────────────────────────────────────────────────────────
# GIPHY_KEY=           # GIF search
