dialogmsg.xyz {
	reverse_proxy app:3000
	# While the app is down or restarting (deploys!), show our own page instead of a blank error.
	# Built by `node errors.js --build`; the status code stays 502/503/504.
	handle_errors {
		@down expression `{err.status_code} in [502, 503, 504]`
		handle @down {
			root * /srv/errors
			rewrite * /{err.status_code}.html
			file_server
		}
	}
}
